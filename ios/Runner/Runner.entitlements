<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Intentionally empty. This file used to declare an iCloud container
	     (iCloud.de.gbs-cidp.cidpbuddy) for programmatic iCloud Drive backups via
	     the icloud_storage package. That backup destination no longer exists —
	     BackupDestination only knows `local` and `saf` — and the container id
	     still carried the old bundle-id prefix, which no longer matches
	     de.fokuspunk.cidpbuddy. Users reach their backups through the Files app
	     instead (UIFileSharingEnabled in Info.plist). -->
</dict>
</plist>
